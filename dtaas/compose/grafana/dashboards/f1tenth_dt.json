{
  "title": "F1Tenth DT vs PT",
  "uid": "f1tenth-dt-pt",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "DT -> PT one-way latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-f1tenth" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "pointSize": 4 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-f1tenth" },
          "query": "from(bucket: \"f1tenth_dt\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"latency\" and r._field == \"one_way_ms\") |> keep(columns: [\"_time\", \"_value\", \"run\"])"
        }
      ]
    },
    {
      "id": 2,
      "title": "X position: DT vs PT",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "influxdb-f1tenth" },
      "fieldConfig": { "defaults": { "unit": "m" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-f1tenth" },
          "query": "from(bucket: \"f1tenth_dt\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"trajectory\" and r._field == \"x\") |> keep(columns: [\"_time\", \"_value\", \"source\", \"run\"])"
        }
      ]
    },
    {
      "id": 3,
      "title": "Y position: DT vs PT",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "influxdb-f1tenth" },
      "fieldConfig": { "defaults": { "unit": "m" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-f1tenth" },
          "query": "from(bucket: \"f1tenth_dt\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"trajectory\" and r._field == \"y\") |> keep(columns: [\"_time\", \"_value\", \"source\", \"run\"])"
        }
      ]
    }
  ]
}
