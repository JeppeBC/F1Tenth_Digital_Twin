<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dt_pt_bridge</name>
  <version>0.1.0</version>
  <description>
    DTaaS packaging of the F1Tenth DT&lt;-&gt;PT bridge, benchmarking and
    teleop nodes. Node logic is copied unmodified from the repo's src/
    at image build time; this package only adds ROS2 entry points and a
    launch file to run them together with f1tenth_gym_ros.
  </description>
  <maintainer email="bangshaab2411@gmail.com">F1Tenth DTaaS</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>f1tenth_gym_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
